# Browser-based RDP gateway. Renders a remote Windows desktop into a plain
# browser tab (noVNC), reaching the RDP host through a customer tunnel's SOCKS
# proxy. Kept separate from the VPN base image so that image stays small.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      freerdp2-x11 \
      xvfb \
      x11vnc \
      novnc \
      websockify \
      x11-utils \
      ca-certificates \
      procps \
 && rm -rf /var/lib/apt/lists/*

COPY rdp-entrypoint.sh /usr/local/bin/rdp-entrypoint
RUN chmod +x /usr/local/bin/rdp-entrypoint

ENTRYPOINT ["/usr/local/bin/rdp-entrypoint"]
