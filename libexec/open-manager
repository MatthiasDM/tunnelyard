#!/usr/bin/env bash
# Open a customer's web console (manager UI, admin portal, intranet app) in a
# browser pinned to that customer's tunnel.
#
# Usage: open-manager <customer> <socks-port> <url>
#
# Runs on the Mac (via a CMD_<label>=@host ... entry), not in the container --
# a tunnel container has no desktop to put a browser on.
#
# Each customer gets its own Firefox profile under
# ~/.config/tunnelyard/browser-profiles/<customer>,
# whose user.js pins that tunnel's SOCKS port with REMOTE DNS. Remote DNS is the
# part that matters: internal manager hostnames generally have no public record,
# so the name has to be resolved by the customer's resolvers inside the tunnel.
# A dedicated profile also means this window cannot reach anything except
# through that tunnel, and your normal Firefox is left alone.
set -euo pipefail

name="${1:?usage: open-manager <customer> <socks-port> <url>}"
port="${2:?missing socks port}"
url="${3:?missing url}"

conf="${TUNNELYARD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tunnelyard}"
profile="$conf/browser-profiles/$name"
# macOS keeps the real binary inside the bundle; elsewhere it is on PATH.
for cand in /Applications/Firefox.app/Contents/MacOS/firefox \
            "$HOME/Applications/Firefox.app/Contents/MacOS/firefox" \
            "$(command -v firefox || true)"; do
    [[ -n "$cand" && -x "$cand" ]] && { ff="$cand"; break; }
done
[[ -n "${ff:-}" ]] || {
    echo "Firefox not found. Install it, or open this yourself with a browser"
    echo "set to SOCKS5 127.0.0.1:$port with remote DNS:"
    echo "  $url"
    exit 1
}

# Rewritten every launch so the port always matches the customer's current
# SOCKS_PORT; user.js is re-applied by Firefox at every startup, so these cannot
# be clicked away by accident.
mkdir -p "$profile"
cat > "$profile/user.js" <<EOF
// Generated by libexec/open-manager for the '$name' tunnel -- do not hand-edit.
user_pref("network.proxy.type", 1);
user_pref("network.proxy.socks", "127.0.0.1");
user_pref("network.proxy.socks_port", $port);
user_pref("network.proxy.socks_version", 5);
user_pref("network.proxy.socks_remote_dns", true);
user_pref("network.proxy.no_proxies_on", "");
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
EOF

# --no-remote is what gets a second Firefox beside your normal one (macOS
# otherwise refuses with "A copy of Firefox is already open"; on Linux it is
# harmless), but it also means
# a running instance cannot be handed a new URL -- hence the guard.
if pgrep -f "browser-profiles/$name" >/dev/null 2>&1; then
    echo "$name console window is already open -- switch to that Firefox."
    echo "  $url"
    exit 0
fi

echo "opening $url"
echo "  via SOCKS 127.0.0.1:$port (remote DNS), profile $profile"
nohup env MOZ_NO_REMOTE=1 "$ff" --profile "$profile" --no-remote "$url" >/dev/null 2>&1 &
